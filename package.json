    "jest": "^29.7.0",
    "jest-diff": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-extended": "^4.0.2",
    "klaw-sync": "8.0.0",
    "legal-eagle": "0.16.0",
    "mini-css-extract-plugin": "2.10.2",
    "node-gyp": "^11.0.0",
    "parallel-webpack": "^2.6.0",
    "parse-dds": "^1.2.1",
    "prettier": "^2.6.0",
    "rimraf": "6.1.3",
    "sass": "1.105.1",
    "sass-loader": "17.0.1",
    "semver": "7.8.5",
    "style-loader": "4.0.0",
    "to-camel-case": "^1.0.0",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "^5.6.3",
    "webpack": "5.111.1",
    "webpack-bundle-analyzer": "5.4.0",
    "webpack-dev-middleware": "8.3.0",
    "webpack-hot-middleware": "^2.25.1",
    "webpack-merge": "^6.0.1",
    "xml2js": "0.6.2",
    "xvfb-maybe": "^0.2.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@github/markdownlint-github": "0.8.4",
    "@types/byline": "4.2.36",
    "@types/codemirror": "5.60.18",
    "@types/deep-equal": "1.0.4",
    "@types/dompurify": "^2.3.1",
    "@types/eslint": "^8.4.1",
    "@types/estree": "^0.0.49",
    "@types/event-kit": "2.4.4",
    "@types/express": "^4.11.0",
    "@types/fs-extra": "^7.0.0",
    "@types/fuzzaldrin-plus": "0.6.5",
